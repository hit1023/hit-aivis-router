# =============================================================================
# 音声合成バックエンドの選択
# =============================================================================
# "local"       … AivisSpeech Engine を使う（既定。GPU が要る）
# "aivis_cloud" … Aivis Cloud API を使う（従量課金・GPU 不要）
#
# どちらを選んでも /speak の入出力は同じ。テキスト置換・話者プリセット・発話履歴・
# ユーザー辞書はどちらのバックエンドでも共通に効く。
# GPU を落としている間だけ aivis_cloud にしておき、復活したら local に戻せるよう、
# 両方の設定を残しておいて構わない（使われるのは TTS_PROVIDER が選ぶ方だけ）。
TTS_PROVIDER=local

# -----------------------------------------------------------------------------
# local（AivisSpeech Engine）用
# -----------------------------------------------------------------------------
# カンマ区切りで複数のAIVISバックエンドURLを指定
AIVIS_BACKEND_URLS=http://aivis-gpu-1:10101,http://aivis-gpu-2:10101

# モデルのアイドルタイムアウト（秒）。デフォルト600秒（10分）
MODEL_IDLE_TIMEOUT=600

# バックエンド管理 API（/backends）と WebUI の「バックエンド」タブ用の管理トークン。
# 空のままだと管理機能は無効（403）。openssl rand -hex 24 などで生成する。
# 設定画面で台を追加・削除すると /data/backends.json に保存され、以後は
# AIVIS_BACKEND_URLS よりそちらが優先される（初回の初期値としてだけ使われる）。
ADMIN_TOKEN=
# 台の追加時にモデルが足りなければ、ここから .aivmx を新しい台へ入れる（遅延同期）。空なら自動同期しない
# MODELS_SOURCE_DIR=/models
# 上記にマウントするホスト側のディレクトリ（基準にする台のエンジンの Models ディレクトリ）
# MODELS_SOURCE_HOST_DIR=/home/user/docker/multi-aivis-speech/data/Models

# -----------------------------------------------------------------------------
# aivis_cloud（Aivis Cloud API）用
# -----------------------------------------------------------------------------
# API キー。https://hub.aivis-project.com/ で発行する。
# クレジット残高が 0 だと 402 で合成に失敗するので事前にチャージが必要。
AIVIS_CLOUD_API_KEY=

# 通常は変更不要
AIVIS_CLOUD_API_URL=https://api.aivis-project.com

# /speakers に載せるモデルをカンマ区切りの UUID で指定する。
# 空にしておくと、ダウンロード数の多い順に AIVIS_CLOUD_CATALOG_LIMIT 件を自動で載せる。
AIVIS_CLOUD_MODEL_UUIDS=
AIVIS_CLOUD_CATALOG_LIMIT=30

# ユーザー辞書の UUID。Cloud 側は「クライアントが UUID を決める」仕様のため、
# 空にしておくと初回起動時に自動生成して /data 配下へ保存し、以後それを使い続ける。
# 別環境と同じ辞書を共有したい場合だけ、ここに明示的に UUID を書く。
AIVIS_CLOUD_USER_DICT_UUID=

# =============================================================================
# 共通
# =============================================================================
# MP3のビットレート（aivis_cloud では output_bitrate として渡される）
MP3_BITRATE=192k
